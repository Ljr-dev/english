# ---------------------------------------------------------------------------
# Docker / Build
# ---------------------------------------------------------------------------
# O runtime não copia node_modules (o Next.js standalone já embute o que a
# aplicação usa), então a imagem final fica pequena e o build rápido.
# BUILDKIT_INLINE_CACHE guarda o cache das camadas na própria imagem, para
# os próximos builds reaproveitarem tudo que não mudou.
DOCKER_BUILDKIT=1
COMPOSE_DOCKER_CLI_BUILD=1

# ---------------------------------------------------------------------------
# Banco de dados — SQL Server (container separado na VPS)
# ---------------------------------------------------------------------------
# Local (docker-compose local) — veja docker-compose.dev.yml
DATABASE_URL="sqlserver://localhost:1433;database=english_course;user=sa;password=YourStrong!Passw0rd;trustServerCertificate=true;encrypt=true"

# Na VPS, aponte para o container/host do SQL Server:
# DATABASE_URL="sqlserver://sqlserver:1433;database=english_course;user=sa;password=SenhaForte;trustServerCertificate=true"
# Rede Docker onde o container `sqlserver` está (nesta VPS: ljr-net)

SQLSERVER_NETWORK="ljr-net"

# ---------------------------------------------------------------------------
# NextAuth (Auth.js) — login por e-mail e senha
# ---------------------------------------------------------------------------
AUTH_SECRET="gere-com-openssl-rand-base64-32"
AUTH_URL="https://english.ljr.dev.br"
AUTH_TRUST_HOST="true"

# ---------------------------------------------------------------------------
# App — administrador inicial (criado pelo `npm run db:seed`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="leandrojoserocha@hotmail.com"
ADMIN_PASSWORD="123456"
